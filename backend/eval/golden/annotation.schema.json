{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Golden syllabus annotation",
  "type": "object",
  "required": ["file", "annotator", "criteria"],
  "additionalProperties": false,
  "properties": {
    "file": { "type": "string", "description": "Anonymized syllabus file name" },
    "annotator": { "type": "string" },
    "annotatedAt": { "type": "string", "format": "date" },
    "isClean": { "type": "boolean", "description": "True if the syllabus has no issues above low severity" },
    "notes": { "type": "string" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterionId", "verdict"],
        "additionalProperties": false,
        "properties": {
          "criterionId": { "type": "string", "pattern": "^(T|LO|AS|PR|PO)-[0-9]+$" },
          "verdict": { "enum": ["ok", "issue", "not_applicable"] },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Headings or short quotes (up to 15 words); \"document-level\" if something is absent"
          },
          "evidenceBlockIds": { "type": "array", "items": { "type": "string" } },
          "acceptableFix": { "type": "string" },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "verdict": { "const": "issue" } }, "required": ["verdict"] },
            "then": { "required": ["severity", "evidence"] }
          }
        ]
      }
    }
  }
}
