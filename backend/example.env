# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1

# Database
MONGODB_URI=mongodb://localhost:27017/ai-syllabus-analyzer

# Auth
JWT_SECRET=change_me_strong_password
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-key
LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=12000

# Timeouts
REQUEST_TIMEOUT_MS=20000
AI_REQUEST_TIMEOUT_MS=130000
KEEP_ALIVE_TIMEOUT_MS=65000

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1500
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
CHAT_MESSAGE_RATE_LIMIT=30

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Uploads
MAX_FILE_SIZE=10485760

# Email
EMAIL_FROM=KSE AI Analyzer <no-reply@example.com>
GMAIL_USER=
GMAIL_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# LibreOffice (.doc → .docx, PDF tracked-версії)
SOFFICE_PATH=
SOFFICE_CONCURRENCY=1
SOFFICE_TIMEOUT_MS=120000
# Паралельна генерація пропозицій під час аналізу
REWRITE_CONCURRENCY=3
# Таймаут читання PDF (pdf.js в окремому worker thread)
PDF_EXTRACT_TIMEOUT_MS=120000
# Lease фонового аналізу: продовжується кожну третину періоду; після рестарту прострочений
# аналіз перезапускається (до 2 спроб)
ANALYSIS_LEASE_MS=60000
# Кейси з перевіреними джерелами: веб-пошук (web_search_preview) для знахідок про кейси
# і серверна перевірка URL. 1 — увімкнено, за замовчуванням вимкнено
CASE_WEB_SEARCH=0

# Зарезервований URL Lecturers CRM; адаптер поки не використовує його й не робить запитів.
LECTURERS_CRM_URL=

